# ============================================================================
# GoBudiBase Local Environment Configuration
# ============================================================================

PORT=8085

# Pilihan A: Koneksi ke PostgreSQL 18 Lokal Windows (Port 5432)
# Ganti 'password_anda' dengan password user postgres lokal Anda
DATABASE_URL=postgres://postgres:password_anda@127.0.0.1:5432/postgres?sslmode=disable

# Pilihan B: Koneksi ke PostgreSQL 17 Server (via SSH Tunnel Port 54322)
# DATABASE_URL=postgres://postgres:postgres@127.0.0.1:54322/postgres?sslmode=disable

JWT_SECRET=super-secret-jwt-token-with-at-least-32-bytes-long
